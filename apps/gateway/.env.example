# Gateway Service — variables de entorno (desarrollo)
# Copiar a .env y completar (el .env no se versiona).

PORT=4000
NODE_ENV=development

# JWT (secreto compartido con los servicios)
JWT_SECRET=dev-secret-change-me

# Token de acceso "interno" (endpoints cross-service de los servicios)
INTERNAL_API_TOKEN=dev-internal-token

# Servicios internos
AUTH_SERVICE_URL=http://localhost:4201
COMMERCE_SERVICE_URL=http://localhost:4202
DELIVERY_SERVICE_URL=http://localhost:4203

# Rate limiting
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100
