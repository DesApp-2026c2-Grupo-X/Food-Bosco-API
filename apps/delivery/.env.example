# Delivery Service — variables de entorno (desarrollo)
# Copiar a .env y completar (el .env no se versiona).

PORT=4203
NODE_ENV=development

# Conexión a MongoDB (la provee el usuario)
# Nube (Atlas):
#   MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/fastfood
# Local:
MONGODB_URI=mongodb://localhost:27017/fastfood

# JWT (secreto compartido con el gateway y los servicios)
JWT_SECRET=dev-secret-change-me

# Servicios internos
AUTH_SERVICE_URL=http://localhost:4201
COMMERCE_SERVICE_URL=http://localhost:4202

# Token de acceso "interno" (para leer GET /v1/users/{id} de Auth y transicionar órdenes en Commerce)
INTERNAL_API_TOKEN=dev-internal-token

# Broker de eventos (RabbitMQ). Si está vacío, se usa un bus en proceso (solo desarrollo/tests).
# CloudAMQP (externo):
#   BROKER_URL=amqps://<user>:<password>@<host>.rmq.cloudamqp.com/<vhost>
# Local:
#   BROKER_URL=amqp://localhost:5672
BROKER_URL=

# Parámetros de oferta de viaje
OFFER_TTL_SECONDS=30
EARNINGS_BASE=500
EARNINGS_PER_KM=200
EARNINGS_PER_ORDER=300
MAX_MATCH_DISTANCE_KM=8
AVG_SPEED_KMH=25
MAX_ORDERS_PER_TRIP=3
