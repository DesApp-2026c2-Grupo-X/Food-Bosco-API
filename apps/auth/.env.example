# Auth Service — variables de entorno (desarrollo)
# Copiar a .env y completar (el .env no se versiona).

PORT=4201
NODE_ENV=development

# Conexión a MongoDB (la provee el usuario)
# Nube (Atlas):
#   MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/fastfood
# Local:
MONGODB_URI=mongodb://localhost:27017/fastfood

# JWT (secreto compartido con el gateway)
JWT_SECRET=dev-secret-change-me
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
PASSWORD_RECOVERY_EXPIRES_IN=1h

# Acceso "interno" (gateway) a GET /v1/users/{id}
INTERNAL_API_TOKEN=dev-internal-token

# Validación de sucursal contra Commerce Service (RQ-AUTH-13, pendiente)
COMMERCE_SERVICE_URL=http://localhost:4202

# Seed del super_admin inicial (npm run seed)
SEED_SUPER_ADMIN_EMAIL=admin@foodbosco.local
SEED_SUPER_ADMIN_PASSWORD=Admin123!
SEED_SUPER_ADMIN_FIRST_NAME=Super
SEED_SUPER_ADMIN_LAST_NAME=Admin
SEED_SUPER_ADMIN_PHONE=0000000000
