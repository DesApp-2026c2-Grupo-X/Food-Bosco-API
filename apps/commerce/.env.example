# Commerce Service — variables de entorno (desarrollo)
# Copiar a .env y completar (el .env no se versiona).

PORT=4202
NODE_ENV=development

# Conexión a MongoDB (la provee el usuario)
# Nube (Atlas):
#   MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/fastfood
# Local:
MONGODB_URI=mongodb://localhost:27017/fastfood

# JWT (secreto compartido con el gateway y los servicios)
JWT_SECRET=dev-secret-change-me

# Token de acceso "interno" (endpoints cross-service del gateway/otros servicios)
INTERNAL_API_TOKEN=dev-internal-token

# Broker de eventos (RabbitMQ). Si está vacío, se usa un bus en proceso (solo desarrollo/tests).
BROKER_URL=

# Valores iniciales de parámetros del sistema (seed). Opcional.
SEED_PARAM_MAX_DISTANCE_KM=10
SEED_PARAM_BASE_PREP_MIN=15
SEED_PARAM_AVG_SPEED_KMH=25

# Uploads de imágenes del catálogo (Cloudinary)
# Credenciales del proyecto de Cloudinary (Dashboard → API Keys).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Carpeta dentro de Cloudinary donde se guardan las imágenes.
CLOUDINARY_FOLDER=fastfood/products
# Tamaño máximo permitido por imagen, en bytes (default 5 MB).
UPLOAD_MAX_SIZE_BYTES=5242880
